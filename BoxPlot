<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>區間計算器</title>
<style>
    /* 全域顏色與深色主題設定 */
    :root {
        --bg-color: #0b0e14;
        --card-bg: #151822;
        --text-main: #ffffff;
        --text-muted: #8b94a5;
        --red: #ff4d6d;
        --green: #00d28f;
        --blue: #2979ff;
        --border: #232838;
    }
    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        margin: 0;
        padding: 20px;
        display: flex;
        justify-content: center;
        box-sizing: border-box;
    }
    .container {
        max-width: 1200px; /* 加寬以容納四個表格並列 */
        width: 100%;
    }
    
    /* 輸入區塊樣式 */
    .input-group {
        background-color: var(--card-bg);
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        display: flex;
        gap: 15px;
        box-sizing: border-box;
        align-items: flex-end;
    }
    .input-field {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 100px;
    }
    .input-field label {
        color: var(--text-muted);
        font-size: 14px;
    }
    .input-field input {
        background-color: var(--bg-color);
        border: 1px solid var(--border);
        color: white;
        padding: 10px;
        border-radius: 6px;
        font-size: 16px;
        outline: none;
        width: 100%;
        box-sizing: border-box;
    }
    .input-field input:focus {
        border-color: var(--blue);
    }
    button {
        background-color: var(--blue);
        color: white;
        border: none;
        padding: 0 25px;
        border-radius: 6px;
        font-size: 16px;
        cursor: pointer;
        height: 42px;
        transition: 0.2s;
        font-weight: bold;
    }
    button:hover {
        opacity: 0.9;
    }

    /* 輸出圖表樣式 (四欄並排) */
    #output {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
    }
    .card {
        background-color: var(--card-bg);
        border-radius: 12px;
        padding: 15px;
        box-sizing: border-box;
    }
    .card-title {
        color: var(--text-muted);
        font-size: 14px;
        margin-bottom: 12px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border);
        text-align: center;
        font-weight: bold;
    }
    .row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid var(--border);
    }
    .row:last-child {
        border-bottom: none;
    }
    
    /* 左右欄位對齊與字體設定 */
    .col-label {
        font-weight: bold;
        font-size: 15px;
    }
    .col-val {
        text-align: right;
        font-size: 16px;
        font-weight: bold;
        letter-spacing: 0.5px;
        color: var(--text-main);
    }

    /* 狀態顏色 */
    .text-red { color: var(--red); }
    .text-green { color: var(--green); }
    .text-blue { color: var(--blue); }

    /* --- 手機版最佳化 --- */
    @media (max-width: 768px) {
        body {
            padding: 10px;
        }
        /* 讓輸入框在手機上堆疊，避免按鈕被擠壓 */
        .input-group {
            flex-direction: column;
            align-items: stretch;
            padding: 15px;
            gap: 12px;
        }
        button {
            height: 45px;
            margin-top: 5px;
        }
        
        /* 手機版改為 2x2 的田字格排版，確保不需要左右滑動且字體足夠大 */
        #output {
            grid-template-columns: repeat(2, 1fr);
            gap: 10px; 
        }
        .card {
            padding: 12px 10px;
            border-radius: 8px;
        }
        .card-title {
            font-size: 13px;
            margin-bottom: 8px;
            padding-bottom: 8px;
        }
        .row {
            padding: 8px 0;
        }
        .col-label {
            font-size: 13px;
        }
        .col-val {
            font-size: 14px;
        }
    }

    /* 針對極小螢幕(如 iPhone SE) 進一步微調 */
    @media (max-width: 400px) {
        #output { gap: 6px; }
        .card { padding: 10px 8px; }
        .card-title { font-size: 12px; }
        .col-label { font-size: 12px; }
        .col-val { font-size: 13px; }
        .row { padding: 6px 0; }
    }
</style>
</head>
<body>

<div class="container">
    <!-- 頂部輸入區 -->
    <div class="input-group">
        <div class="input-field">
            <label>最大值 (Max)</label>
            <input type="number" id="maxVal" value="49243">
        </div>
        <div class="input-field">
            <label>最小值 (Min)</label>
            <input type="number" id="minVal" value="39438">
        </div>
        <button onclick="calculate()">計算</button>
    </div>

    <!-- 結果渲染區 -->
    <div id="output"></div>
</div>

<script>
    // 建立單行資料的 HTML，改為左側(標籤) + 右側(數值) 兩欄結構
    function createRow(label, val, type) {
        let colorClass = '';
        if (type === 'up') colorClass = 'text-red';
        if (type === 'down') colorClass = 'text-green';
        if (type === 'mid') colorClass = 'text-blue';

        return `
        <div class="row">
            <div class="col-label ${colorClass}">${label}</div>
            <div class="col-val">${val}</div>
        </div>`;
    }

    // 建立表格卡片的 HTML
    function createCard(title, rowsHTML) {
        return `
        <div class="card">
            <div class="card-title">${title}</div>
            ${rowsHTML}
        </div>`;
    }

    // 主要計算邏輯
    function calculate() {
        const max = parseFloat(document.getElementById('maxVal').value);
        const min = parseFloat(document.getElementById('minVal').value);
        
        if (isNaN(max) || isNaN(min) || max <= min) {
            alert("請輸入正確的數值 (最大值需大於最小值)");
            return;
        }

        const range = max - min;
        
        // 核心四分位數 (先行四捨五入)
        const q3_val = Math.round(min + range * 0.75);
        const q2_val = Math.round(min + range * 0.5);
        const q1_val = Math.round(min + range * 0.25);

        let html = "";

        // --- Big Bridge ---
        let t1_rows = "";
        t1_rows += createRow("", max, "up");
        t1_rows += createRow("壓力", q3_val, "up");
        t1_rows += createRow("分界", q2_val, "mid");
        t1_rows += createRow("支撐", q1_val, "down");
        t1_rows += createRow("", min, "down");
        html += createCard("Big Bridge", t1_rows);

        // --- U - Bridge ---
        const upper_step = (q3_val - q2_val) / 4;
        const lower_step = (q2_val - q1_val) / 4;
        
        let t2_rows = "";
        t2_rows += createRow("", q3_val, "up");
        t2_rows += createRow("壓力", Math.round(q2_val + upper_step * 3), "up");
        t2_rows += createRow("分界", Math.round(q2_val + upper_step * 2), "up");
        t2_rows += createRow("支撐", Math.round(q2_val + upper_step * 1), "up");
        t2_rows += createRow("", q2_val, "mid");
        html += createCard("U - Bridge", t2_rows);

        // --- D - Bridge ---
        // 這裡不需要重複宣告 upper_step 和 lower_step，直接使用上面的即可
        let t3_rows = "";
        t3_rows += createRow("", q2_val, "mid");
        t3_rows += createRow("壓力", Math.round(q1_val + lower_step * 3), "down");
        t3_rows += createRow("分界", Math.round(q1_val + lower_step * 2), "down");
        t3_rows += createRow("支撐", Math.round(q1_val + lower_step * 1), "down");
        t3_rows += createRow("", q1_val, "down");
        html += createCard("D - Bridge", t3_rows);

        // --- Box III ---
        const fib_ratios = [0.809, 0.705, 0.618, 0.5, 0.382, 0.295, 0.191];
        let t4_rows = "";
        fib_ratios.forEach(ratio => {
            const val = Math.round(min + range * ratio);
            let type = ratio > 0.5 ? "up" : (ratio < 0.5 ? "down" : "mid");
            t4_rows += createRow(ratio.toString(), val, type);
        });
        html += createCard("Box III", t4_rows);

        // 將結果寫入網頁
        document.getElementById('output').innerHTML = html;
    }

    // 網頁載入時自動執行一次計算
    window.onload = calculate;
</script>
</body>
</html>
